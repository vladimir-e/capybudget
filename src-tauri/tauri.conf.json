{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capy Budget",
  "version": "1.4.1",
  "identifier": "app.capybudget.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": "^(https?://|/).+"
    },
    "updater": {
      "endpoints": [
        "https://github.com/vladimir-e/capybudget/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDMTE2RDQ2RTU3NTE1NjAKUldSZ0ZYWGxSbTBSUFA3UzN6WlN2dzc3c0FZdXJPbTE5a1cyMWZUQWNBdGRXd3ZHeHBFbUsyYXgK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Capy Budget",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
