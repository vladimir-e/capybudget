{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mas",
  "description": "Capability set for the sandboxed Mac App Store build: no self-updater, no subprocess spawning, no shell path-open. URL-opening is https-only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-size",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "opener:allow-reveal-item-in-dir",
    "store:default",
    "window-state:default"
  ]
}
