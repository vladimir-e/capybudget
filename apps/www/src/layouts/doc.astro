---
import Base from "./base.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Base title={`${title} — Capy Budget Docs`} description={description}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <nav class="mb-8 text-sm text-subtle">
      <a href="/docs/user-guide" class="hover:text-body transition-colors">Docs</a>
    </nav>
    <article>
      <h1 class="text-3xl font-bold text-heading">{title}</h1>
      <div class="mt-8 space-y-6 text-body leading-relaxed [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-heading [&_h2]:mt-10 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-heading [&_h3]:mt-6 [&_code]:rounded [&_code]:bg-code-bg [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-sm [&_code]:text-code-text [&_a]:text-brand [&_a]:underline [&_a:hover]:text-brand-light [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mt-2 [&_pre]:rounded-lg [&_pre]:bg-pre-bg [&_pre]:p-4 [&_pre]:text-sm [&_pre]:text-pre-text [&_pre_code]:bg-transparent [&_pre_code]:p-0">
        <slot />
      </div>
    </article>
  </div>
</Base>
