  <script is:inline>
    // Detect platform; swap the hero CTA, mini links, and Get It badge.
    (function() {
      var ua = navigator.userAgent.toLowerCase();
      var plat = (navigator.platform || '').toLowerCase();
      var detected = 'mac';
      if (/win/.test(plat) || /windows/.test(ua)) detected = 'windows';
      else if (/linux/.test(plat) || /linux/.test(ua)) detected = 'linux';
      else if (/mac/.test(plat) || /macintosh/.test(ua)) detected = 'mac';

      // Hero CTA: show the detected platform's button, hide the others.
      document.querySelectorAll('[data-cta]').forEach(function(cta) {
        if (cta.getAttribute('data-cta') === detected) cta.classList.remove('hidden');
        else cta.classList.add('hidden');
      });

      // Hero mini row: hide the detected platform (it's the primary CTA),
      // show the other two as alternatives.
      document.querySelectorAll('[data-mini]').forEach(function(mini) {
        if (mini.getAttribute('data-mini') === detected) mini.classList.add('hidden');
        else mini.classList.remove('hidden');
      });
      // Separator dots: hide if any of the platforms they depend on is hidden.
      document.querySelectorAll('[data-sep-deps]').forEach(function(sep) {
        var deps = sep.getAttribute('data-sep-deps').split(',');
        var anyHidden = deps.some(function(p) { return p === detected; });
        if (anyHidden) sep.classList.add('hidden');
        else sep.classList.remove('hidden');
      });

      // Get It section: highlight the matching platform card.
      document.querySelectorAll('[data-platform]').forEach(function(card) {
        if (card.getAttribute('data-platform') === detected) {
          card.classList.add('is-detected');
        }
      });
    })();
  </script>
