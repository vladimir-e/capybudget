---
import Base from "../layouts/base.astro";

const repoUrl = "https://github.com/vladimir-e/capybudget";
const releasesUrl = `${repoUrl}/releases`;
const downloadBase = `${releasesUrl}/latest/download`;
const macUrl = `${downloadBase}/capybudget-macos.dmg`;
const windowsUrl = `${downloadBase}/capybudget-windows-x64.exe`;
const linuxUrl = `${downloadBase}/capybudget-linux-x64.AppImage`;
const demoUrl = "https://demo.capybudget.app";
---

<Base
  title="Capy Budget — AI-powered budgeting. Local-first, private, plain CSV."
  description="Local-first budgeting app with AI built in. Your data stays on your machine in plain CSV files. Free and open source for macOS, Windows, and Linux."
>
  <!-- ============================================================ -->
  <!-- HERO                                                          -->
  <!-- ============================================================ -->
  <section class="relative">
    <div class="mx-auto max-w-5xl px-6 pt-20 pb-20 sm:pt-24 sm:pb-28 text-center">
      <h1 class="font-serif font-extrabold tracking-tight text-heading text-5xl sm:text-7xl text-balance leading-[1.05]">
        Budgeting with a brain.
      </h1>

      <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-body">
        No subscription, no cloud, no lock-in. Plain CSV files that you can open in Excel.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href={macUrl} class="btn-primary" data-cta="mac" target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M11.6 8.4c0-1.5 1.2-2.2 1.3-2.2-.7-1-1.8-1.2-2.2-1.2-.9-.1-1.8.6-2.3.6-.5 0-1.2-.5-2-.5-1 0-2 .6-2.5 1.5-1.1 1.9-.3 4.7.8 6.2.5.8 1.1 1.6 1.9 1.6.8 0 1.1-.5 2-.5.9 0 1.2.5 2 .5.8 0 1.4-.8 1.9-1.5.6-.9.9-1.8.9-1.9-.1 0-1.7-.7-1.8-2.6zM10.1 4c.4-.5.7-1.2.6-1.9-.6.1-1.3.4-1.7.9-.4.4-.8 1.1-.7 1.8.7.1 1.4-.3 1.8-.8z" />
          </svg>
          <span>Download for macOS</span>
          <span class="font-mono text-[11px] font-normal opacity-70">.dmg</span>
        </a>
        <a href={windowsUrl} class="btn-primary hidden" data-cta="windows" target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M0 2.3 6.5 1.4v5.9H0V2.3zm0 5.6h6.5v5.9L0 13V7.9zm7.2-6.6L16 0v7.3H7.2V1.3zm0 6.7H16V16l-8.8-1.3V7.9z" />
          </svg>
          <span>Download for Windows</span>
          <span class="font-mono text-[11px] font-normal opacity-70">.exe</span>
        </a>
        <a href={linuxUrl} class="btn-primary hidden" data-cta="linux" target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M7.96 2.06c-1.62 0-2.43 1.46-2.43 3.4 0 .7.13 1.34.4 1.85.27.5.66.92 1.08 1.3.42.36.92.74 1.36 1.04.45.3.84.5.94.5.1 0 .49-.2.94-.5.44-.3.94-.68 1.36-1.04.42-.38.81-.8 1.08-1.3.27-.51.4-1.15.4-1.85 0-1.94-.81-3.4-2.43-3.4-.8 0-1.16.4-1.35.8-.19-.4-.55-.8-1.35-.8zM6.5 5c.28 0 .5.36.5.8s-.22.8-.5.8c-.28 0-.5-.36-.5-.8s.22-.8.5-.8zm3 0c.28 0 .5.36.5.8s-.22.8-.5.8c-.28 0-.5-.36-.5-.8s.22-.8.5-.8zM5.2 10.1c-.32.1-.6.4-.84.74-.5.7-.86 1.74-1.07 2.46-.1.36-.2.78-.06 1.18.13.4.5.66.94.74.42.07.83-.07 1.2-.22.5-.2 1.02-.34 1.55-.34.6 0 1.13.16 1.62.34.5.2 1 .42 1.55.42.55 0 1.05-.22 1.55-.42.48-.18 1.03-.34 1.62-.34.53 0 1.04.14 1.55.34.36.15.77.29 1.2.22.42-.08.8-.34.94-.74.13-.4.04-.82-.06-1.18-.21-.72-.57-1.76-1.07-2.46-.24-.34-.52-.64-.84-.74-.34-.1-.7.04-.96.27-.46.4-.94 1.06-1.6 1.4-.46.24-.96.4-1.5.4-.4 0-.78-.08-1.13-.22a3.7 3.7 0 0 1-.95-.54c-.17-.14-.34-.3-.5-.42-.16-.13-.32-.24-.5-.32-.17-.07-.36-.1-.55-.1s-.38.03-.55.1z" />
          </svg>
          <span>Download for Linux</span>
          <span class="font-mono text-[11px] font-normal opacity-70">.AppImage</span>
        </a>
        <a href={repoUrl} class="btn-secondary" target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          <span>View on GitHub</span>
        </a>
      </div>

      <p class="mt-5 flex items-center justify-center gap-2 text-xs font-mono text-muted">
        <a href={macUrl} class="platform-mini hidden" data-mini="mac" target="_blank" rel="noopener noreferrer">
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M11.6 8.4c0-1.5 1.2-2.2 1.3-2.2-.7-1-1.8-1.2-2.2-1.2-.9-.1-1.8.6-2.3.6-.5 0-1.2-.5-2-.5-1 0-2 .6-2.5 1.5-1.1 1.9-.3 4.7.8 6.2.5.8 1.1 1.6 1.9 1.6.8 0 1.1-.5 2-.5.9 0 1.2.5 2 .5.8 0 1.4-.8 1.9-1.5.6-.9.9-1.8.9-1.9-.1 0-1.7-.7-1.8-2.6zM10.1 4c.4-.5.7-1.2.6-1.9-.6.1-1.3.4-1.7.9-.4.4-.8 1.1-.7 1.8.7.1 1.4-.3 1.8-.8z" />
          </svg>
          macOS
        </a>
        <span data-sep-deps="mac" class="platform-mini-sep hidden opacity-40">·</span>
        <a href={windowsUrl} class="platform-mini" data-mini="windows" target="_blank" rel="noopener noreferrer">
          <svg class="h-3 w-3" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M0 2.3 6.5 1.4v5.9H0V2.3zm0 5.6h6.5v5.9L0 13V7.9zm7.2-6.6L16 0v7.3H7.2V1.3zm0 6.7H16V16l-8.8-1.3V7.9z" />
          </svg>
          Windows
        </a>
        <span data-sep-deps="windows,linux" class="platform-mini-sep opacity-40">·</span>
        <a href={linuxUrl} class="platform-mini" data-mini="linux" target="_blank" rel="noopener noreferrer">
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M7.96 2.06c-1.62 0-2.43 1.46-2.43 3.4 0 .7.13 1.34.4 1.85.27.5.66.92 1.08 1.3.42.36.92.74 1.36 1.04.45.3.84.5.94.5.1 0 .49-.2.94-.5.44-.3.94-.68 1.36-1.04.42-.38.81-.8 1.08-1.3.27-.51.4-1.15.4-1.85 0-1.94-.81-3.4-2.43-3.4-.8 0-1.16.4-1.35.8-.19-.4-.55-.8-1.35-.8zM6.5 5c.28 0 .5.36.5.8s-.22.8-.5.8c-.28 0-.5-.36-.5-.8s.22-.8.5-.8zm3 0c.28 0 .5.36.5.8s-.22.8-.5.8c-.28 0-.5-.36-.5-.8s.22-.8.5-.8zM5.2 10.1c-.32.1-.6.4-.84.74-.5.7-.86 1.74-1.07 2.46-.1.36-.2.78-.06 1.18.13.4.5.66.94.74.42.07.83-.07 1.2-.22.5-.2 1.02-.34 1.55-.34.6 0 1.13.16 1.62.34.5.2 1 .42 1.55.42.55 0 1.05-.22 1.55-.42.48-.18 1.03-.34 1.62-.34.53 0 1.04.14 1.55.34.36.15.77.29 1.2.22.42-.08.8-.34.94-.74.13-.4.04-.82-.06-1.18-.21-.72-.57-1.76-1.07-2.46-.24-.34-.52-.64-.84-.74-.34-.1-.7.04-.96.27-.46.4-.94 1.06-1.6 1.4-.46.24-.96.4-1.5.4-.4 0-.78-.08-1.13-.22a3.7 3.7 0 0 1-.95-.54c-.17-.14-.34-.3-.5-.42-.16-.13-.32-.24-.5-.32-.17-.07-.36-.1-.55-.1s-.38.03-.55.1z" />
          </svg>
          Linux
        </a>
      </p>

      <!-- ============================================================ -->
      <!-- APP MOCKUP                                                    -->
      <!-- ============================================================ -->
      <div class="mockup-wrap mt-16" aria-hidden="true">
        <div class="mockup">
          <!-- macOS window chrome -->
          <div class="mockup-chrome">
            <div class="mockup-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-amber"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="mockup-title">Capy Budget — Household</div>
            <div class="w-[60px]"></div>
          </div>

          <div class="mockup-body">
            <!-- LEFT SIDEBAR -->
            <aside class="mockup-sidebar">
              <p class="mockup-path">~/budgets/Household 2026</p>

              <div class="net-worth-card">
                <p class="net-worth-label">NET WORTH</p>
                <p class="net-worth-value">$142,835</p>
                <p class="net-worth-delta">+$2,341 this month</p>
              </div>

              <div class="sidebar-group">
                <div class="group-header">
                  <span>CASH</span>
                  <span class="group-total pos">$1,425</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">💵</span>Cash</span>
                  <span class="acc-amount pos">$425</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">💵</span>Stash</span>
                  <span class="acc-amount pos">$1,000</span>
                </div>
              </div>

              <div class="sidebar-group">
                <div class="group-header">
                  <span>CHECKING</span>
                  <span class="group-total neg">-$2,423</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">🏦</span>BofA Checking</span>
                  <span class="acc-amount neg">-$2,423</span>
                </div>
              </div>

              <div class="sidebar-group">
                <div class="group-header">
                  <span>CREDIT CARD</span>
                  <span class="group-total neg">-$5,328</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">🍎</span>Apple Card</span>
                  <span class="acc-amount neg">-$2,619</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">💳</span>BofA Rewards</span>
                  <span class="acc-amount neg">-$2,709</span>
                </div>
              </div>

              <div class="sidebar-group">
                <div class="group-header">
                  <span>INVESTMENTS</span>
                  <span class="group-total pos">$149,161</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">📈</span>Merrill Edge</span>
                  <span class="acc-amount pos">$34,958</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">🏛</span>401(k)</span>
                  <span class="acc-amount pos">$104,290</span>
                </div>
              </div>
            </aside>

            <!-- RIGHT PANE -->
            <section class="mockup-main">
              <div class="overview-header">
                <p class="overview-label">📈 Spending overview</p>
                <p class="overview-value">$3,847.52 <span class="overview-suffix">this month</span></p>
              </div>

              <div class="chart-card">
                <p class="chart-label">LAST 6 MONTHS</p>
                <svg viewBox="0 0 400 100" preserveAspectRatio="none" class="chart-svg">
                  <defs>
                    <linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1">
                      <stop offset="0%" stop-color="oklch(0.62 0.16 38)" stop-opacity="0.4" />
                      <stop offset="100%" stop-color="oklch(0.62 0.16 38)" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <polygon
                    points="20,70 100,55 180,60 260,40 340,30 380,20 380,100 20,100"
                    fill="url(#chartFill)"
                  />
                  <polyline
                    points="20,70 100,55 180,60 260,40 340,30 380,20"
                    fill="none"
                    stroke="oklch(0.72 0.16 40)"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <div class="budget-row">
                <div class="budget-card">
                  <p class="budget-name">Housing</p>
                  <p class="budget-amount">$2,941</p>
                  <div class="budget-bar"><div class="budget-fill green" style="width: 64%"></div><span class="budget-div" style="left: 70%"></span></div>
                  <p class="budget-pct"><span class="auto-tag">auto</span> $3,200</p>
                </div>
                <div class="budget-card">
                  <p class="budget-name">Food</p>
                  <p class="budget-amount">$487</p>
                  <div class="budget-bar"><div class="budget-fill green" style="width: 58%"></div><span class="budget-div" style="left: 70%"></span></div>
                  <p class="budget-pct"><span class="auto-tag">auto</span> $590</p>
                </div>
                <div class="budget-card">
                  <p class="budget-name">Transport</p>
                  <p class="budget-amount">$215</p>
                  <div class="budget-bar"><div class="budget-fill red" style="width: 82%"></div><span class="budget-div" style="left: 70%"></span></div>
                  <p class="budget-pct neg">-$15</p>
                </div>
              </div>

              <div class="txn-table">
                <div class="txn-header">
                  <span>DATE</span>
                  <span>MERCHANT</span>
                  <span>CATEGORY</span>
                  <span class="ta-right">AMOUNT</span>
                </div>
                <div class="txn-row">
                  <span class="txn-date">May 6</span>
                  <span class="txn-merchant">Whole Foods</span>
                  <span class="txn-category">Groceries</span>
                  <span class="txn-amount neg">-$87.42</span>
                </div>
                <div class="txn-row">
                  <span class="txn-date">May 5</span>
                  <span class="txn-merchant">Salary</span>
                  <span class="txn-category">Income</span>
                  <span class="txn-amount pos">+$4,230.00</span>
                </div>
                <div class="txn-row">
                  <span class="txn-date">May 4</span>
                  <span class="txn-merchant">Apple</span>
                  <span class="txn-category">Subscriptions</span>
                  <span class="txn-amount neg">-$9.99</span>
                </div>
                <div class="txn-row">
                  <span class="txn-date">May 3</span>
                  <span class="txn-merchant">Uber</span>
                  <span class="txn-category">Transport</span>
                  <span class="txn-amount neg">-$23.40</span>
                </div>
                <div class="txn-row fade-out">
                  <span class="txn-date">May 3</span>
                  <span class="txn-merchant">Stripe</span>
                  <span class="txn-category">Income</span>
                  <span class="txn-amount pos">+$1,200.00</span>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>

      <div class="mt-10 flex justify-center">
        <a href={demoUrl} class="btn-secondary" target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75 16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" />
          </svg>
          <span>Try the live demo</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- WHY CAPY                                                      -->
  <!-- ============================================================ -->
  <section class="bg-surface-alt border-y border-line">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="eyebrow">WHY CAPY</p>
      <h2 class="mt-3 text-center font-serif font-bold text-heading text-4xl sm:text-5xl text-balance">
        Built like a tool, not a service.
      </h2>

      <!-- Trigger cards — text-only on both desktop and mobile. The matching -->
      <!-- vignette renders in the shared canvas (desktop) or canvas-mobile.   -->
      <div class="showcase-cards mt-14" aria-label="Why Capy showcase">
        <button class="showcase-card" type="button" data-showcase-trigger="accounts" aria-selected="false">
          <span class="showcase-card-icon" aria-hidden="true">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m13.5-3A2.25 2.25 0 0 1 19.5 9v.878m0 0a2.246 2.246 0 0 0-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0 1 21 12v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6c0-.98.626-1.813 1.5-2.122" />
            </svg>
          </span>
          <h3 class="showcase-card-title">All your money in one place</h3>
          <p class="showcase-card-body">
            Cash, checking, savings, credit cards, investments. Every account,
            every transaction, one view.
          </p>
        </button>

        <button class="showcase-card is-active" type="button" data-showcase-trigger="budget" aria-selected="true">
          <span class="showcase-card-icon" aria-hidden="true">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />
            </svg>
          </span>
          <h3 class="showcase-card-title">See where it goes</h3>
          <p class="showcase-card-body">
            Spending breakdowns, monthly budgets, net worth over time. Ask
            in plain English, or just click around.
          </p>
        </button>

        <button class="showcase-card" type="button" data-showcase-trigger="import" aria-selected="false">
          <span class="showcase-card-icon" aria-hidden="true">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
          </span>
          <h3 class="showcase-card-title">Skip the data entry</h3>
          <p class="showcase-card-body">
            Drop in a CSV from your bank, a statement screenshot, a photo of a
            receipt. Tell Capy what's there. It does the rest.
          </p>
        </button>
      </div>

      <!-- Shared mobile canvas: dedicated vignettes per card. Stacks like the -->
      <!-- desktop canvas (only .is-active is visible). Desktop hides this.    -->
      <div class="showcase-canvas-mobile" aria-live="polite">
        <!-- Mobile vignette: account hierarchy close-up -->
        <div class="showcase-mobile-mockup" data-showcase-panel-mobile="accounts">
          <p class="smv-path">~/budgets/Household</p>
          <div class="smv-networth">
            <p class="smv-networth-label">NET WORTH</p>
            <p class="smv-networth-value">$46,437.58</p>
            <p class="smv-networth-delta">+$1,820.34 this month</p>
          </div>
          <div class="sidebar-group">
            <div class="group-header">
              <span>CHECKING</span>
            </div>
            <div class="account-row">
              <span class="acc-name"><span class="acc-emoji">🏦</span>Checking</span>
              <span class="acc-amount pos">$2,450.18</span>
            </div>
          </div>
          <div class="sidebar-group">
            <div class="group-header">
              <span>SAVINGS</span>
            </div>
            <div class="account-row">
              <span class="acc-name"><span class="acc-emoji">💰</span>Savings</span>
              <span class="acc-amount pos">$12,840.55</span>
            </div>
          </div>
          <div class="sidebar-group">
            <div class="group-header">
              <span>CREDIT CARD</span>
            </div>
            <div class="account-row">
              <span class="acc-name"><span class="acc-emoji">🍎</span>Apple Card</span>
              <span class="acc-amount neg">-$1,247.33</span>
            </div>
            <div class="account-row">
              <span class="acc-name"><span class="acc-emoji">💳</span>Capital One Venture</span>
              <span class="acc-amount neg">-$456.92</span>
            </div>
