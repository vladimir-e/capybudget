---
import Base from "../layouts/base.astro";

const RELEASES_BASE = "https://github.com/vladimir-e/capybudget/releases/latest/download";
const downloads = [
  { os: "macOS", href: `${RELEASES_BASE}/capybudget-macos.dmg` },
  { os: "Windows", href: `${RELEASES_BASE}/capybudget-windows-x64.msi` },
  { os: "Linux (AppImage)", href: `${RELEASES_BASE}/capybudget-linux-x64.AppImage` },
  { os: "Linux (.deb)", href: `${RELEASES_BASE}/capybudget-linux-x64.deb` },
];
---

<Base title="Capy Budget — Personal Finance, Your Way">
  <!-- Hero -->
  <section class="relative mx-auto max-w-5xl px-6 pt-28 pb-24 text-center">
    <div class="mascot-wrap mx-auto mb-10">
      <div class="mascot-glow"></div>
      <img
        src="/capy-great.png"
        alt="Capybara mascot in a suit sipping a cocktail"
        class="mascot relative z-10 mx-auto h-48 w-48 drop-shadow-lg"
      />
    </div>

    <h1 class="text-5xl font-extrabold tracking-tight sm:text-7xl">
      Budget like a <span class="gradient-text">capybara</span>.
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
      A local-first personal finance app. Your data lives in plain CSV files
      in a folder you choose. No cloud, no subscription, no nonsense.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href={downloads[0].href} class="btn-primary">
        Download for {downloads[0].os}
      </a>
      <a
        href="https://demo.capybudget.app"
        class="btn-secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        Try the Demo
      </a>
      <a
        href="https://github.com/vladimir-e/capybudget"
        class="btn-secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        View on GitHub
      </a>
    </div>

    <p class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-muted">
      {downloads.slice(1).map((d, i) => (
        <>
          {i > 0 && <span aria-hidden="true">·</span>}
          <a href={d.href} class="download-link">{d.os}</a>
        </>
      ))}
    </p>
  </section>

  <!-- Features -->
  <section class="border-t border-line bg-surface-alt">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <h2 class="text-center text-2xl font-bold text-heading sm:text-3xl">
        Why Capy Budget?
      </h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <div class="feature-card">
          <div class="feature-icon">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776" />
            </svg>
          </div>
          <h3 class="mt-4 font-semibold text-heading">Plain CSV Files</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Your data is human-readable CSV. Open it in Excel, write scripts
            against it, or just back it up by copying a folder.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon feature-icon-sage">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
          </div>
          <h3 class="mt-4 font-semibold text-heading">No Cloud, No Account</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Everything runs locally. No sign-ups, no servers, no telemetry.
            Point your data folder at iCloud or Dropbox for free sync.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon feature-icon-gold">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
            </svg>
          </div>
          <h3 class="mt-4 font-semibold text-heading">AI-Powered Import</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Paste a bank statement or CSV and let Claude parse, categorize, and
            deduplicate your transactions. You review before anything is saved.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
            </svg>
          </div>
          <h3 class="mt-4 font-semibold text-heading">Every Account Type</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Cash, checking, savings, credit cards, investments, loans, crypto
            — track everything in one place with derived balances.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon feature-icon-sage">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
          </div>
          <h3 class="mt-4 font-semibold text-heading">Keyboard-First</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            Built for speed. Type transactions, navigate with shortcuts,
            and manage your budget without reaching for the mouse.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon feature-icon-gold">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
            </svg>
          </div>
          <h3 class="mt-4 font-semibold text-heading">Open Source</h3>
          <p class="mt-2 text-sm leading-relaxed text-subtle">
            MIT licensed. Read every line, fork it, extend it.
            Built with Tauri, React, and TypeScript.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-5xl px-6 py-20 text-center">
    <div class="cta-card rounded-2xl px-8 py-14">
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <img src="/capy-fine.png" alt="" class="h-24 w-24 mascot" />
        <div class="text-left">
          <h2 class="text-2xl font-bold text-heading">Ready to take control?</h2>
          <p class="mt-1 text-muted">Download the app or try the web demo first.</p>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={downloads[0].href} class="btn-primary">
          Download for {downloads[0].os}
        </a>
        <a
          href="https://demo.capybudget.app"
          class="btn-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Try the Demo
        </a>
      </div>
      <p class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-muted">
        {downloads.slice(1).map((d, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={d.href} class="download-link">{d.os}</a>
          </>
        ))}
      </p>
    </div>
  </section>
</Base>

<style>
  /* ========== Gradient text ========== */
  .gradient-text {
    background: linear-gradient(135deg, var(--color-terra) 0%, var(--color-gold) 50%, var(--color-sage) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  :global([data-theme="dark"]) .gradient-text {
    background: linear-gradient(135deg, #f59e0b, #ea580c, #f59e0b);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradient-shift 6s ease-in-out infinite;
  }
  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* ========== Mascot ========== */
  .mascot-wrap {
    position: relative;
    width: 12rem;
    height: 12rem;
  }
  .mascot-glow {
    display: none;
    position: absolute;
    inset: -20%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.35), rgba(234, 88, 12, 0.15), transparent 70%);
    animation: pulse 4s ease-in-out infinite;
  }
  :global([data-theme="dark"]) .mascot-glow {
    display: block;
  }
  .mascot {
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.7; }
    50% { transform: scale(1.12); opacity: 1; }
  }

  /* ========== Buttons ========== */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 600;
    color: white;
    background: linear-gradient(135deg, var(--color-terra), var(--color-terra-light));
    box-shadow: 0 4px 14px oklch(0.5 0.12 38 / 0.3);
    transition: all 0.25s ease;
  }
  .btn-primary:hover {
    transform: scale(1.06);
    box-shadow: 0 6px 20px oklch(0.5 0.12 38 / 0.4);
  }
  :global([data-theme="dark"]) .btn-primary {
    background: linear-gradient(135deg, #f59e0b, #ea580c);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.3), 0 0 60px rgba(245, 158, 11, 0.1);
  }
  :global([data-theme="dark"]) .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 30px rgba(245, 158, 11, 0.5), 0 0 80px rgba(245, 158, 11, 0.2);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sem-heading);
    background: var(--sem-surface);
    border: 2px solid var(--sem-line);
    transition: all 0.25s ease;
  }
  .btn-secondary:hover {
    transform: scale(1.06);
  }
  :global([data-theme="dark"]) .btn-secondary {
    backdrop-filter: blur(8px);
  }
  :global([data-theme="dark"]) .btn-secondary:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(245, 158, 11, 0.3);
  }

  /* ========== Secondary platform download links ========== */
  .download-link {
    color: var(--sem-heading);
    text-decoration: underline;
    text-decoration-color: var(--sem-line);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease, color 0.2s ease;
  }
  .download-link:hover {
    color: var(--color-terra);
    text-decoration-color: var(--color-terra);
  }
  :global([data-theme="dark"]) .download-link:hover {
    color: #f59e0b;
    text-decoration-color: #f59e0b;
  }

  /* ========== Feature cards ========== */
  .feature-card {
    background: var(--sem-surface);
    border-radius: 1rem;
    padding: 1.75rem;
    border: 1px solid var(--sem-line);
    box-shadow: 0 2px 12px oklch(0.5 0.03 55 / 0.08);
    transition: all 0.3s ease;
  }
  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px oklch(0.5 0.05 55 / 0.12);
  }
  :global([data-theme="dark"]) .feature-card {
    backdrop-filter: blur(12px);
    box-shadow: none;
  }
  :global([data-theme="dark"]) .feature-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(245, 158, 11, 0.2);
    box-shadow: 0 8px 32px rgba(245, 158, 11, 0.08);
  }

  /* ========== Feature icons ========== */
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: oklch(0.95 0.06 38);
    color: var(--color-terra);
  }
  .feature-icon-sage {
    background: oklch(0.94 0.05 148);
    color: var(--color-sage);
  }
  .feature-icon-gold {
    background: oklch(0.94 0.06 85);
    color: oklch(0.55 0.14 85);
  }
  :global([data-theme="dark"]) .feature-icon,
  :global([data-theme="dark"]) .feature-icon-sage,
  :global([data-theme="dark"]) .feature-icon-gold {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(234, 88, 12, 0.1));
    border: 1px solid rgba(245, 158, 11, 0.2);
    color: #f59e0b;
  }

  /* ========== CTA card ========== */
  :global([data-theme="dark"]) .cta-card {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.06), rgba(234, 88, 12, 0.03), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(245, 158, 11, 0.1);
    backdrop-filter: blur(16px);
  }

  /* ========== Reduced motion ========== */
  @media (prefers-reduced-motion: reduce) {
    .mascot, .mascot-glow { animation: none; }
    :global([data-theme="dark"]) .gradient-text { animation: none; }
    .feature-card:hover { transform: none; }
    .btn-primary:hover, .btn-secondary:hover { transform: none; }
  }
</style>
