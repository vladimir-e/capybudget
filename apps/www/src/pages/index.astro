---
import Base from "../layouts/base.astro";

const version = "1.0";
const repoUrl = "https://github.com/vladimir-e/capybudget";
const releasesUrl = `${repoUrl}/releases`;
---

<Base title="Capy Budget — Local-first personal finance">
  <!-- ============================================================ -->
  <!-- HERO                                                          -->
  <!-- ============================================================ -->
  <section class="relative">
    <div class="mx-auto max-w-5xl px-6 pt-20 pb-20 sm:pt-24 sm:pb-28 text-center">
      <p class="version-pill">
        <span aria-hidden="true">•</span> Open source · v{version}
      </p>

      <h1 class="mt-6 font-serif font-extrabold tracking-tight text-heading text-5xl sm:text-7xl text-balance leading-[1.05]">
        Personal finance for people who keep their own files.
      </h1>

      <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-body">
        Plain CSV files. AI inside. No cloud, no account, no lock-in. Open
        your data in Excel any time.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href={releasesUrl} class="btn-primary" data-cta="mac" target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M11.6 8.4c0-1.5 1.2-2.2 1.3-2.2-.7-1-1.8-1.2-2.2-1.2-.9-.1-1.8.6-2.3.6-.5 0-1.2-.5-2-.5-1 0-2 .6-2.5 1.5-1.1 1.9-.3 4.7.8 6.2.5.8 1.1 1.6 1.9 1.6.8 0 1.1-.5 2-.5.9 0 1.2.5 2 .5.8 0 1.4-.8 1.9-1.5.6-.9.9-1.8.9-1.9-.1 0-1.7-.7-1.8-2.6zM10.1 4c.4-.5.7-1.2.6-1.9-.6.1-1.3.4-1.7.9-.4.4-.8 1.1-.7 1.8.7.1 1.4-.3 1.8-.8z" />
          </svg>
          <span>Download for macOS</span>
          <span class="font-mono text-[11px] font-normal opacity-70">.dmg</span>
        </a>
        <a href={releasesUrl} class="btn-primary hidden" data-cta="windows" target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M0 2.3 6.5 1.4v5.9H0V2.3zm0 5.6h6.5v5.9L0 13V7.9zm7.2-6.6L16 0v7.3H7.2V1.3zm0 6.7H16V16l-8.8-1.3V7.9z" />
          </svg>
          <span>Download for Windows</span>
          <span class="font-mono text-[11px] font-normal opacity-70">.exe</span>
        </a>
        <a href={releasesUrl} class="btn-primary hidden" data-cta="linux" target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M7.96 2.06c-1.62 0-2.43 1.46-2.43 3.4 0 .7.13 1.34.4 1.85.27.5.66.92 1.08 1.3.42.36.92.74 1.36 1.04.45.3.84.5.94.5.1 0 .49-.2.94-.5.44-.3.94-.68 1.36-1.04.42-.38.81-.8 1.08-1.3.27-.51.4-1.15.4-1.85 0-1.94-.81-3.4-2.43-3.4-.8 0-1.16.4-1.35.8-.19-.4-.55-.8-1.35-.8zM6.5 5c.28 0 .5.36.5.8s-.22.8-.5.8c-.28 0-.5-.36-.5-.8s.22-.8.5-.8zm3 0c.28 0 .5.36.5.8s-.22.8-.5.8c-.28 0-.5-.36-.5-.8s.22-.8.5-.8zM5.2 10.1c-.32.1-.6.4-.84.74-.5.7-.86 1.74-1.07 2.46-.1.36-.2.78-.06 1.18.13.4.5.66.94.74.42.07.83-.07 1.2-.22.5-.2 1.02-.34 1.55-.34.6 0 1.13.16 1.62.34.5.2 1 .42 1.55.42.55 0 1.05-.22 1.55-.42.48-.18 1.03-.34 1.62-.34.53 0 1.04.14 1.55.34.36.15.77.29 1.2.22.42-.08.8-.34.94-.74.13-.4.04-.82-.06-1.18-.21-.72-.57-1.76-1.07-2.46-.24-.34-.52-.64-.84-.74-.34-.1-.7.04-.96.27-.46.4-.94 1.06-1.6 1.4-.46.24-.96.4-1.5.4-.4 0-.78-.08-1.13-.22a3.7 3.7 0 0 1-.95-.54c-.17-.14-.34-.3-.5-.42-.16-.13-.32-.24-.5-.32-.17-.07-.36-.1-.55-.1s-.38.03-.55.1z" />
          </svg>
          <span>Download for Linux</span>
          <span class="font-mono text-[11px] font-normal opacity-70">.AppImage</span>
        </a>
        <a href={repoUrl} class="btn-secondary" target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          <span>View on GitHub</span>
        </a>
      </div>

      <p class="platform-mini-row mt-5 flex items-center justify-center gap-2 text-xs font-mono text-muted">
        <a href={releasesUrl} class="platform-mini hidden" data-mini="mac" target="_blank" rel="noopener noreferrer">
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M11.6 8.4c0-1.5 1.2-2.2 1.3-2.2-.7-1-1.8-1.2-2.2-1.2-.9-.1-1.8.6-2.3.6-.5 0-1.2-.5-2-.5-1 0-2 .6-2.5 1.5-1.1 1.9-.3 4.7.8 6.2.5.8 1.1 1.6 1.9 1.6.8 0 1.1-.5 2-.5.9 0 1.2.5 2 .5.8 0 1.4-.8 1.9-1.5.6-.9.9-1.8.9-1.9-.1 0-1.7-.7-1.8-2.6zM10.1 4c.4-.5.7-1.2.6-1.9-.6.1-1.3.4-1.7.9-.4.4-.8 1.1-.7 1.8.7.1 1.4-.3 1.8-.8z" />
          </svg>
          macOS
        </a>
        <span data-sep-deps="mac" class="platform-mini-sep hidden opacity-40">·</span>
        <a href={releasesUrl} class="platform-mini" data-mini="windows" target="_blank" rel="noopener noreferrer">
          <svg class="h-3 w-3" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M0 2.3 6.5 1.4v5.9H0V2.3zm0 5.6h6.5v5.9L0 13V7.9zm7.2-6.6L16 0v7.3H7.2V1.3zm0 6.7H16V16l-8.8-1.3V7.9z" />
          </svg>
          Windows
        </a>
        <span data-sep-deps="windows,linux" class="platform-mini-sep opacity-40">·</span>
        <a href={releasesUrl} class="platform-mini" data-mini="linux" target="_blank" rel="noopener noreferrer">
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M7.96 2.06c-1.62 0-2.43 1.46-2.43 3.4 0 .7.13 1.34.4 1.85.27.5.66.92 1.08 1.3.42.36.92.74 1.36 1.04.45.3.84.5.94.5.1 0 .49-.2.94-.5.44-.3.94-.68 1.36-1.04.42-.38.81-.8 1.08-1.3.27-.51.4-1.15.4-1.85 0-1.94-.81-3.4-2.43-3.4-.8 0-1.16.4-1.35.8-.19-.4-.55-.8-1.35-.8zM6.5 5c.28 0 .5.36.5.8s-.22.8-.5.8c-.28 0-.5-.36-.5-.8s.22-.8.5-.8zm3 0c.28 0 .5.36.5.8s-.22.8-.5.8c-.28 0-.5-.36-.5-.8s.22-.8.5-.8zM5.2 10.1c-.32.1-.6.4-.84.74-.5.7-.86 1.74-1.07 2.46-.1.36-.2.78-.06 1.18.13.4.5.66.94.74.42.07.83-.07 1.2-.22.5-.2 1.02-.34 1.55-.34.6 0 1.13.16 1.62.34.5.2 1 .42 1.55.42.55 0 1.05-.22 1.55-.42.48-.18 1.03-.34 1.62-.34.53 0 1.04.14 1.55.34.36.15.77.29 1.2.22.42-.08.8-.34.94-.74.13-.4.04-.82-.06-1.18-.21-.72-.57-1.76-1.07-2.46-.24-.34-.52-.64-.84-.74-.34-.1-.7.04-.96.27-.46.4-.94 1.06-1.6 1.4-.46.24-.96.4-1.5.4-.4 0-.78-.08-1.13-.22a3.7 3.7 0 0 1-.95-.54c-.17-.14-.34-.3-.5-.42-.16-.13-.32-.24-.5-.32-.17-.07-.36-.1-.55-.1s-.38.03-.55.1z" />
          </svg>
          Linux
        </a>
      </p>

      <!-- ============================================================ -->
      <!-- APP MOCKUP                                                    -->
      <!-- ============================================================ -->
      <div class="mockup-wrap mt-16" aria-hidden="true">
        <div class="mockup">
          <!-- macOS window chrome -->
          <div class="mockup-chrome">
            <div class="mockup-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-amber"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="mockup-title">Capy Budget — Household 2026</div>
            <div class="w-[60px]"></div>
          </div>

          <div class="mockup-body">
            <!-- LEFT SIDEBAR -->
            <aside class="mockup-sidebar">
              <p class="mockup-path">~/budgets/Household 2026</p>

              <div class="net-worth-card">
                <p class="net-worth-label">NET WORTH</p>
                <p class="net-worth-value">$142,835</p>
                <p class="net-worth-delta">+$2,341 this month</p>
              </div>

              <div class="sidebar-group">
                <div class="group-header">
                  <span>CASH</span>
                  <span class="group-total pos">$1,425</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">💵</span>Cash</span>
                  <span class="acc-amount pos">$425</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">💵</span>Stash</span>
                  <span class="acc-amount pos">$1,000</span>
                </div>
              </div>

              <div class="sidebar-group">
                <div class="group-header">
                  <span>CHECKING</span>
                  <span class="group-total neg">-$2,423</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">🏦</span>BofA Checking</span>
                  <span class="acc-amount neg">-$2,423</span>
                </div>
              </div>

              <div class="sidebar-group">
                <div class="group-header">
                  <span>CREDIT CARD</span>
                  <span class="group-total neg">-$5,328</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">🍎</span>Apple Card</span>
                  <span class="acc-amount neg">-$2,619</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">💳</span>BofA Rewards</span>
                  <span class="acc-amount neg">-$2,709</span>
                </div>
              </div>

              <div class="sidebar-group">
                <div class="group-header">
                  <span>INVESTMENTS</span>
                  <span class="group-total pos">$149,161</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">📈</span>Merrill Edge</span>
                  <span class="acc-amount pos">$34,958</span>
                </div>
                <div class="account-row">
                  <span class="acc-name"><span class="acc-emoji">🏛</span>401(k)</span>
                  <span class="acc-amount pos">$104,290</span>
                </div>
              </div>
            </aside>

            <!-- RIGHT PANE -->
            <section class="mockup-main">
              <div class="overview-header">
                <p class="overview-label">📈 Spending overview</p>
                <p class="overview-value">$3,847.52 <span class="overview-suffix">this month</span></p>
              </div>

              <div class="chart-card">
                <p class="chart-label">LAST 6 MONTHS</p>
                <svg viewBox="0 0 400 100" preserveAspectRatio="none" class="chart-svg">
                  <defs>
                    <linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1">
                      <stop offset="0%" stop-color="oklch(0.62 0.16 38)" stop-opacity="0.4" />
                      <stop offset="100%" stop-color="oklch(0.62 0.16 38)" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <polygon
                    points="20,70 100,55 180,60 260,40 340,30 380,20 380,100 20,100"
                    fill="url(#chartFill)"
                  />
                  <polyline
                    points="20,70 100,55 180,60 260,40 340,30 380,20"
                    fill="none"
                    stroke="oklch(0.72 0.16 40)"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <div class="budget-row">
                <div class="budget-card">
                  <p class="budget-name">Housing</p>
                  <p class="budget-amount">$2,941</p>
                  <div class="budget-bar"><div class="budget-fill terra" style="width: 81%"></div></div>
                  <p class="budget-pct">81% of budget</p>
                </div>
                <div class="budget-card">
                  <p class="budget-name">Food</p>
                  <p class="budget-amount">$487</p>
                  <div class="budget-bar"><div class="budget-fill green" style="width: 62%"></div></div>
                  <p class="budget-pct">62% of budget</p>
                </div>
                <div class="budget-card">
                  <p class="budget-name">Transport</p>
                  <p class="budget-amount">$215</p>
                  <div class="budget-bar"><div class="budget-fill terra" style="width: 34%"></div></div>
                  <p class="budget-pct">34% of budget</p>
                </div>
              </div>

              <div class="txn-table">
                <div class="txn-header">
                  <span>DATE</span>
                  <span>MERCHANT</span>
                  <span>CATEGORY</span>
                  <span class="ta-right">AMOUNT</span>
                </div>
                <div class="txn-row">
                  <span class="txn-date">May 6</span>
                  <span class="txn-merchant">Whole Foods</span>
                  <span class="txn-category">Groceries</span>
                  <span class="txn-amount neg">-$87.42</span>
                </div>
                <div class="txn-row">
                  <span class="txn-date">May 5</span>
                  <span class="txn-merchant">Salary</span>
                  <span class="txn-category">Income</span>
                  <span class="txn-amount pos">+$4,230.00</span>
                </div>
                <div class="txn-row">
                  <span class="txn-date">May 4</span>
                  <span class="txn-merchant">Apple</span>
                  <span class="txn-category">Subscriptions</span>
                  <span class="txn-amount neg">-$9.99</span>
                </div>
                <div class="txn-row">
                  <span class="txn-date">May 3</span>
                  <span class="txn-merchant">Uber</span>
                  <span class="txn-category">Transport</span>
                  <span class="txn-amount neg">-$23.40</span>
                </div>
                <div class="txn-row fade-out">
                  <span class="txn-date">May 3</span>
                  <span class="txn-merchant">Stripe</span>
                  <span class="txn-category">Income</span>
                  <span class="txn-amount pos">+$1,200.00</span>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- WHY CAPY                                                      -->
  <!-- ============================================================ -->
  <section class="bg-surface-alt border-y border-line">
    <div class="mx-auto max-w-5xl px-6 py-24">
      <p class="eyebrow">WHY CAPY</p>
      <h2 class="mt-3 text-center font-serif font-bold text-heading text-4xl sm:text-5xl text-balance">
        Built like a tool, not a service.
      </h2>

      <div class="mt-14 grid gap-5 sm:grid-cols-3">
        <article class="why-card">
          <div class="why-header">
            <span class="why-icon" aria-hidden="true">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026M3.75 9.776a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542M3.75 9.776V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776" />
              </svg>
            </span>
            <h3 class="why-title">Just a folder</h3>
          </div>
          <p class="why-body">
            Your budget lives in a folder of plain CSV files. Drop it in
            iCloud, Dropbox, or git — sync however you already sync.
          </p>
          <p class="why-footer">CSV · JSON</p>
        </article>

        <article class="why-card">
          <div class="why-header">
            <span class="why-icon" aria-hidden="true">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4" />
              </svg>
            </span>
            <h3 class="why-title">AI that knows your money</h3>
          </div>
          <p class="why-body">
            Ask Capy to find duplicates, summarize spending, or set budgets.
            Bring your own key — Claude, OpenAI, or Claude Code with your subscription.
          </p>
          <p class="why-footer">BYO key</p>
        </article>

        <article class="why-card">
          <div class="why-header">
            <span class="why-icon" aria-hidden="true">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
              </svg>
            </span>
            <h3 class="why-title">Stays on your machine</h3>
          </div>
          <p class="why-body">
            No telemetry. No accounts. No cloud database. Your transactions
            never touch our servers because there are no servers.
          </p>
          <p class="why-footer">0 KB sent</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- FEATURES                                                      -->
  <!-- ============================================================ -->
  <section id="features" class="border-b border-line">
    <div class="mx-auto max-w-5xl px-6 py-24">
      <p class="eyebrow">FEATURES</p>
      <h2 class="mt-3 text-center font-serif font-bold text-heading text-4xl sm:text-5xl text-balance">
        Everything Capy does.
      </h2>

      <div class="mt-14 grid gap-12 sm:grid-cols-3 sm:gap-10">
        <div>
          <p class="feature-group-label">Data</p>
          <ul class="feature-list">
            <li>Cash, credit cards, investments, loans</li>
            <li>Net worth tracking</li>
            <li>Monthly budgeting</li>
            <li>Spending summaries and trends</li>
            <li>CSV import — banks, Mint, YNAB</li>
            <li>Manual transactions entry</li>
            <li>Plain CSV files on disk</li>
          </ul>
        </div>
        <div>
          <p class="feature-group-label">Intelligence</p>
          <ul class="feature-list">
            <li>Auto-categorization on import</li>
            <li>Image recognition for receipts</li>
            <li>Natural language queries</li>
            <li>AI model can perform all actions</li>
            <li>Works with OpenAI, Claude API, or Claude Code with your subscription</li>
            <li>MCP server — allow other agents to work with your budget</li>
          </ul>
        </div>
        <div>
          <p class="feature-group-label">Privacy &amp; ownership</p>
          <ul class="feature-list">
            <li>Your data never leaves your machine</li>
            <li>No account, no sign-up, no telemetry</li>
            <li>Sync via iCloud, Google Drive, or git</li>
            <li>Bring your own API key for AI features</li>
            <li>Open Source — fork or contribute</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- HOW IT WORKS                                                  -->
  <!-- ============================================================ -->
  <section id="how-it-works" class="border-b border-line">
    <div class="mx-auto max-w-5xl px-6 py-24">
      <p class="eyebrow">HOW IT WORKS</p>
      <h2 class="mt-3 text-center font-serif font-bold text-heading text-4xl sm:text-5xl text-balance">
        Three steps, zero ceremony.
      </h2>

      <div class="mt-14 border-t border-line pt-10 grid gap-10 sm:grid-cols-3">
        <div class="step">
          <p class="step-num">01</p>
          <h3 class="step-title">Create or open a folder</h3>
          <p class="step-body">
            Pick a folder on your computer. That's your budget. Capy creates a few CSVs.
          </p>
        </div>
        <div class="step">
          <p class="step-num">02</p>
