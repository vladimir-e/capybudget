  .txn-header {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: rgba(254, 243, 199, 0.4);
    letter-spacing: 0.12em;
    padding-bottom: 0.4rem;
  }
  .ta-right { text-align: right; }
  .txn-date {
    font-family: var(--font-mono);
    color: rgba(254, 243, 199, 0.55);
  }
  .txn-merchant {
    color: #fef3c7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .txn-category {
    color: rgba(254, 243, 199, 0.55);
  }
  .txn-amount {
    font-family: var(--font-mono);
    text-align: right;
  }
  .txn-amount.pos { color: oklch(0.78 0.16 145); }
  .txn-amount.neg { color: rgba(254, 243, 199, 0.78); }
  .txn-row.fade-out {
    mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
  }

  /* ============================================================ */
  /* WHY CAPY — SHOWCASE                                           */
  /* ============================================================ */

  /* Trigger cards: desktop = row of 3 compact buttons.            */
  /*                mobile  = horizontal scroll with snap.         */
  .showcase-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 767px) {
    .showcase-cards {
      display: flex;
      grid-template-columns: none;
      gap: 0.85rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      /* Extra bottom padding so the .is-active card's ▼ arrow has room   */
      /* to render inside the scroll container without being clipped.     */
      /* No horizontal padding/margin so cards inherit the same width     */
      /* math as the canvas below (both 85% of the section inner width).  */
      padding: 0 0 1.75rem;
      margin-top: 2.5rem;
      scrollbar-width: none;
    }
    .showcase-cards::-webkit-scrollbar { display: none; }
  }

  .showcase-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 1.4rem 1.4rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .showcase-card:hover {
    border-color: oklch(0.78 0.07 60);
  }
  :global([data-theme="dark"]) .showcase-card:hover {
    border-color: rgba(245, 158, 11, 0.25);
  }
  .showcase-card.is-active {
    border-color: var(--color-terra);
    background: color-mix(in oklab, var(--color-terra-soft) 50%, var(--color-surface));
    box-shadow: 0 0 0 1px var(--color-terra) inset;
  }
  :global([data-theme="dark"]) .showcase-card.is-active {
    background: color-mix(in oklab, oklch(0.62 0.16 38) 8%, var(--color-surface));
    border-color: oklch(0.82 0.14 50);
    box-shadow: 0 0 0 1px oklch(0.82 0.14 50) inset;
  }
  /* Active cue — a terra ▼ arrow sits below the selected card, pointing  */
  /* at the matching mockup in the canvas (desktop) or canvas-mobile.     */
  .showcase-card.is-active::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -0.85rem;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-top: 7px solid var(--color-terra);
    pointer-events: none;
  }
  :global([data-theme="dark"]) .showcase-card.is-active::after {
    border-top-color: oklch(0.82 0.14 50);
  }
  @media (min-width: 768px) {
    .showcase-cards {
      overflow: visible;
    }
  }
  @media (max-width: 767px) {
    .showcase-card {
      flex: 0 0 85%;
      scroll-snap-align: center;
      cursor: default;
    }
  }

  .showcase-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: var(--color-terra-soft);
    color: var(--color-terra);
    flex-shrink: 0;
  }
  :global([data-theme="dark"]) .showcase-card-icon {
    background: rgba(245, 158, 11, 0.12);
    color: oklch(0.82 0.14 50);
  }
  .showcase-card-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-heading);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .showcase-card-body {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-body);
  }

  /* Shared desktop canvas: stacks mockups, cross-fades active one */
  .showcase-canvas {
    position: relative;
    margin-top: 2.5rem;
    min-height: 750px;
  }
  @media (max-width: 767px) {
    .showcase-canvas { display: none; }
  }

  .showcase-mockup {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, visibility 0.18s ease;
    pointer-events: none;
  }
  .showcase-mockup.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    position: relative;
  }

  /* Mobile canvas: parallel to the desktop one, stacks dedicated mobile  */
  /* vignettes that cross-fade as cards activate. Hidden on desktop.      */
  .showcase-canvas-mobile {
    display: none;
  }
  @media (max-width: 767px) {
    .showcase-canvas-mobile {
      display: block;
      position: relative;
      width: 85%;
      max-width: 420px;
      margin: 1.5rem auto 0;
    }
  }

  /* Mobile vignettes: small focused compositions. Each panel stacks      */
  /* absolutely inside .showcase-canvas-mobile; only .is-active is shown. */
  .showcase-mobile-mockup {
    display: none;
  }
  @media (max-width: 767px) {
    .showcase-mobile-mockup {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      background: #0c0a09;
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 0.75rem;
      padding: 0.9rem;
      color: #fef3c7;
      font-size: 11px;
      line-height: 1.4;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.04) inset,
        0 12px 28px -16px rgba(0, 0, 0, 0.5);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.18s ease, visibility 0.18s ease;
      pointer-events: none;
    }
    .showcase-mobile-mockup.is-active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      position: relative;
    }
  }

