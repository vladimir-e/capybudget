  <script is:inline>
    // Detect platform; swap the hero CTA, mini links, and Get It badge.
    (function() {
      var ua = navigator.userAgent.toLowerCase();
      var plat = (navigator.platform || '').toLowerCase();
      var detected = 'mac';
      if (/win/.test(plat) || /windows/.test(ua)) detected = 'windows';
      else if (/linux/.test(plat) || /linux/.test(ua)) detected = 'linux';
      else if (/mac/.test(plat) || /macintosh/.test(ua)) detected = 'mac';

      // Hero CTA: show the detected platform's button, hide the others.
      document.querySelectorAll('[data-cta]').forEach(function(cta) {
        if (cta.getAttribute('data-cta') === detected) cta.classList.remove('hidden');
        else cta.classList.add('hidden');
      });

      // Hero mini row: hide the detected platform (it's the primary CTA),
      // show the other two as alternatives.
      document.querySelectorAll('[data-mini]').forEach(function(mini) {
        if (mini.getAttribute('data-mini') === detected) mini.classList.add('hidden');
        else mini.classList.remove('hidden');
      });
      // Separator dots: hide if any of the platforms they depend on is hidden.
      document.querySelectorAll('[data-sep-deps]').forEach(function(sep) {
        var deps = sep.getAttribute('data-sep-deps').split(',');
        var anyHidden = deps.some(function(p) { return p === detected; });
        if (anyHidden) sep.classList.add('hidden');
        else sep.classList.remove('hidden');
      });

      // Get It section: highlight the matching platform card.
      document.querySelectorAll('[data-platform]').forEach(function(card) {
        if (card.getAttribute('data-platform') === detected) {
          card.classList.add('is-detected');
        }
      });
    })();
  </script>

  <script is:inline>
    // Showcase: trigger cards swap the active mockup in both the desktop
    // canvas and the mobile canvas. On mobile, horizontal scroll auto-
    // activates whichever card is centered (via IntersectionObserver).
    (function() {
      var triggers = document.querySelectorAll('[data-showcase-trigger]');
      var panels = document.querySelectorAll('[data-showcase-panel]');
      var mPanels = document.querySelectorAll('[data-showcase-panel-mobile]');
      if (!triggers.length || !panels.length) return;

      function activate(key) {
        triggers.forEach(function(t) {
          var on = t.getAttribute('data-showcase-trigger') === key;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function(p) {
          p.classList.toggle('is-active', p.getAttribute('data-showcase-panel') === key);
        });
        mPanels.forEach(function(p) {
          p.classList.toggle('is-active', p.getAttribute('data-showcase-panel-mobile') === key);
        });
      }

      triggers.forEach(function(t) {
        t.addEventListener('click', function() {
          activate(t.getAttribute('data-showcase-trigger'));
          // On mobile, also scroll the tapped card into the snap-center
          // position. Without this, tapping a peeking card edge activates it
          // but the IntersectionObserver immediately overrides because the
          // originally-centered card still has the higher intersection ratio.
          if (mql.matches) {
            t.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
          }
        });
      });

      // Budget tabs inside Mockup 2 (desktop canvas only — mobile vignette
      // for Budget has no tabs, just donut + category list).
      var canvasBudget = document.querySelector('.showcase-canvas [data-showcase-panel="budget"]');
      if (canvasBudget) {
        var tabs = canvasBudget.querySelectorAll('[data-budget-tab]');
        var bpanels = canvasBudget.querySelectorAll('[data-budget-panel]');
        tabs.forEach(function(tab) {
          tab.addEventListener('click', function() {
            var key = tab.getAttribute('data-budget-tab');
            tabs.forEach(function(t) {
              var on = t.getAttribute('data-budget-tab') === key;
              t.classList.toggle('is-active', on);
              t.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            bpanels.forEach(function(p) {
              p.classList.toggle('is-active', p.getAttribute('data-budget-panel') === key);
            });
          });
        });
      }

      // Mobile: pre-scroll cards row so Card 2 (Budget) is centered, and
      // hook up an IntersectionObserver so horizontal scroll auto-selects.
      var cardsRow = document.querySelector('.showcase-cards');
      if (!cardsRow) return;
      var mql = window.matchMedia('(max-width: 767px)');
      var observer = null;
      var ratios = new Map();

      function centerActiveCard() {
        var active = cardsRow.querySelector('.showcase-card.is-active');
        if (!active) return;
        cardsRow.scrollLeft = active.offsetLeft - (cardsRow.clientWidth - active.clientWidth) / 2;
      }

      function pickFromRatios() {
        var best = null;
        var bestRatio = 0;
        ratios.forEach(function(ratio, el) {
          if (ratio > bestRatio) { bestRatio = ratio; best = el; }
        });
        if (best && bestRatio > 0.6) {
          var key = best.getAttribute('data-showcase-trigger');
          if (key && !best.classList.contains('is-active')) activate(key);
        }
      }

      function enableObserver() {
        if (observer) return;
        observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            ratios.set(entry.target, entry.intersectionRatio);
          });
          pickFromRatios();
        }, { root: cardsRow, threshold: [0, 0.3, 0.6, 0.9, 1] });
        triggers.forEach(function(t) { observer.observe(t); });
      }

      function disableObserver() {
        if (!observer) return;
        observer.disconnect();
        observer = null;
        ratios.clear();
      }

      function syncMode() {
        if (mql.matches) {
          requestAnimationFrame(centerActiveCard);
          enableObserver();
        } else {
          disableObserver();
        }
      }

      syncMode();
      // matchMedia listener: addEventListener is the modern API; fall back
      // to addListener for older Safari versions that still ship in the wild.
      if (mql.addEventListener) mql.addEventListener('change', syncMode);
      else if (mql.addListener) mql.addListener(syncMode);
    })();
  </script>
</Base>

